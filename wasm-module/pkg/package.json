{
  "name": "rust-fetch",
  "type": "module",
  "collaborators": [
    "Asem Qaffaf <asem@qaffaf.com>"
  ],
  "description": "A reliable HTTP client for JavaScript and TypeScript, written in Rust and compiled to WebAssembly: timeouts, retries, typed errors and interceptors, faster than fetch() in Node.js",
  "version": "2.1.1",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/asemqaffaf/rust-fetch"
  },
  "files": [
    "rust_fetch_bg.wasm",
    "rust_fetch_bg.wasm.d.ts",
    "rust_fetch.js",
    "rust_fetch.d.ts",
    "node.js",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "main": "rust_fetch.js",
  "types": "rust_fetch.d.ts",
  "sideEffects": [
    "./snippets/*"
  ],
  "keywords": [
    "wasm",
    "http",
    "client",
    "fetch",
    "webassembly"
  ],
  "exports": {
    ".": {
      "types": "./rust_fetch.d.ts",
      "node": "./node.js",
      "default": "./rust_fetch.js"
    },
    "./rust_fetch.js": {
      "types": "./rust_fetch.d.ts",
      "default": "./rust_fetch.js"
    },
    "./rust_fetch_bg.wasm": "./rust_fetch_bg.wasm",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/asemqaffaf/rust-fetch#readme",
  "bugs": {
    "url": "https://github.com/asemqaffaf/rust-fetch/issues"
  }
}
