{
  "name": "rust-fetch",
  "type": "module",
  "collaborators": [
    "Asem Qaffaf <asem@qaffaf.com>"
  ],
  "description": "Resilient HTTP client for JavaScript, TypeScript and Rust: fetch() with timeouts, retries, typed errors, interceptors, upload and download progress, and WebSockets, from one Rust core compiled to WebAssembly for browsers and Node.js",
  "version": "2.5.1",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/asemqaffaf/rust-fetch"
  },
  "files": [
    "rust_fetch_bg.wasm",
    "rust_fetch_bg.wasm.d.ts",
    "rust_fetch.js",
    "rust_fetch.d.ts",
    "node.js",
    "llms.txt",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "main": "rust_fetch.js",
  "homepage": "https://github.com/asemqaffaf/rust-fetch#readme",
  "types": "rust_fetch.d.ts",
  "sideEffects": [
    "./snippets/*"
  ],
  "keywords": [
    "http",
    "http-client",
    "fetch",
    "fetch-api",
    "request",
    "rest",
    "api-client",
    "axios-alternative",
    "retry",
    "retries",
    "backoff",
    "timeout",
    "interceptors",
    "typed-errors",
    "abortcontroller",
    "upload-progress",
    "download-progress",
    "streaming",
    "websocket",
    "websockets",
    "reconnect",
    "typescript",
    "nodejs",
    "browser",
    "isomorphic",
    "webassembly",
    "wasm",
    "rust",
    "napi"
  ],
  "exports": {
    ".": {
      "types": "./rust_fetch.d.ts",
      "node": "./node.js",
      "default": "./rust_fetch.js"
    },
    "./rust_fetch.js": {
      "types": "./rust_fetch.d.ts",
      "default": "./rust_fetch.js"
    },
    "./rust_fetch_bg.wasm": "./rust_fetch_bg.wasm",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/asemqaffaf/rust-fetch/issues"
  }
}
